# Production Environment Variables

# Database Connection (Supabase/Neon/Postgres)
DATABASE_URL="postgresql://user:password@host:5432/db_name?schema=public"

# NextAuth Security
NEXTAUTH_URL="https://www.rental-mobil.com"
NEXTAUTH_SECRET="generate-a-secure-random-string-in-production"

# AWS S3 Storage (For Image Uploads)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your-live-access-key"
AWS_SECRET_ACCESS_KEY="your-live-secret-key"
AWS_S3_BUCKET_NAME="production-rental-images"

# Payment Gateway (Example: Midtrans / Stripe)
PAYMENT_SECRET_KEY="live-secret-key"
PAYMENT_CLIENT_KEY="live-client-key"

# Application Config
NEXT_PUBLIC_APP_URL="https://www.rental-mobil.com"
